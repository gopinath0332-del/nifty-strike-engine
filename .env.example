# ============================================================
# Nifty Strike Engine — Environment Configuration
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# ------ Zerodha Kite Connect --------------------------------
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
KITE_ACCESS_TOKEN=your_access_token_here   # Refresh daily via scripts/refresh_token.py

# ------ Discord Notifications --------------------------------
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_URL_HERE

# ------ Live Trading Flag -----------------------------------
# Set LIVE_ORDER_PLACEMENT=false to run in simulation mode.
# All logic executes and Discord alerts fire, but NO orders hit the exchange.
# Set to true ONLY when you are ready to trade real money.
LIVE_ORDER_PLACEMENT=false

# ------ Trade Settings --------------------------------------
LOT_SIZE=65                  # NIFTY current lot size (units per contract)
MAX_TRADES_PER_DAY=1         # Only 1 trade per day — CE OR PE, never both

# ------ Indicator Parameters (Pine Script defaults) ----------
ST_ATR_PERIOD=10
ST_FACTOR=3.0
RSI_LENGTH=14
BB_LENGTH=20
BB_MULT=2.0

# ------ Session Timing (IST) --------------------------------
CANDLE_INTERVAL_MINUTES=3
ENTRY_CUTOFF_TIME=14:45      # No new entries after this time
EOD_EXIT_TIME=15:00          # Hard force-close all open positions


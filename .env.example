# ============================================================
# Nifty Strike Engine — Environment Configuration (.env)
# Only secret keys, tokens, and credentials belong here!
# Strategy, indicator, timing, and trade settings are in:
#   config/settings.yaml
# ============================================================

# ------ Zerodha Kite Connect --------------------------------
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
KITE_ACCESS_TOKEN=your_access_token_here   # Refreshed automatically by auto_login.py

# ------ Zerodha Auto-Login Credentials (Zero-Touch TOTP) ---
ZERODHA_USER_ID=your_zerodha_client_id
ZERODHA_PASSWORD=your_zerodha_password
ZERODHA_TOTP_SECRET=your_totp_secret_key_here   # From Kite Profile > Password & Security

# ------ Discord Notifications --------------------------------
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1568208979576881263/RNJYGAZe-jGwxTpBHmQDFTuOlzOx6SSUr22dh9yZhzlFhstdHL-gal4TjEbmwgt7dZ6w

# ------ Live Trading Gate -----------------------------------
# Set LIVE_ORDER_PLACEMENT=false to run in simulation mode.
# All logic executes and Discord alerts fire, but NO orders hit the exchange.
# Set to true ONLY when you are ready to trade real money.
LIVE_ORDER_PLACEMENT=false



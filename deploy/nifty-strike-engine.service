# deploy/nifty-strike-engine.service
# ==================================
# Systemd service file for running Nifty Strike Engine as root
# on a Raspberry Pi 5 production server.

[Unit]
Description=Nifty Strike Engine — Algorithmic Options Trading Bot
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/nifty-strike-engine
ExecStart=/root/venv/bin/python main.py
Restart=on-failure
RestartSec=10
KillMode=process
TimeoutStopSec=30
EnvironmentFile=/root/nifty-strike-engine/.env

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nifty-strike-engine

[Install]
WantedBy=multi-user.target

# deploy/nifty-strike-engine.service
# ==================================
# Systemd service file for running Nifty Strike Engine as user pi
# on a Raspberry Pi production server.

[Unit]
Description=Nifty Strike Engine — Algorithmic Options Trading Bot
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/nifty-strike-engine
ExecStart=/home/pi/nifty-strike-engine/venv/bin/python main.py
Restart=always
RestartSec=10
KillMode=process
TimeoutStopSec=30
EnvironmentFile=/home/pi/nifty-strike-engine/.env

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nifty-strike-engine

[Install]
WantedBy=multi-user.target

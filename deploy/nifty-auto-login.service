# deploy/nifty-auto-login.service
# ===============================
# Systemd service to run Zero-Touch Zerodha Auto-Login at morning boot or via timer.

[Unit]
Description=Nifty Strike Engine — Morning Auto-Login
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/nifty-strike-engine
ExecStart=/home/pi/nifty-strike-engine/venv/bin/python /home/pi/nifty-strike-engine/scripts/auto_login.py --restart-service
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nifty-auto-login
